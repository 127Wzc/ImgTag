# PostgreSQL 连接字符串（必须配置）
PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/imgtag

# PostgreSQL 通用连接池配置（每个应用进程独立）
# 默认最多 5 个连接，可按并发需求和数据库连接额度调整
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=600
DB_POOL_PRE_PING=true

# 同步并发及数据库临时异常重试（尝试次数包含首次执行）
STORAGE_SYNC_CONCURRENCY=2
STORAGE_SYNC_DB_MAX_ATTEMPTS=5
STORAGE_SYNC_DB_RETRY_DELAY=2

# 服务地址（可选，默认 http://localhost:8000）
# BASE_URL=http://localhost:8000

# 上传目录（可选，默认 ./uploads）
# UPLOAD_DIR=/path/to/uploads

# 日志级别（可选，默认 INFO，可选值: DEBUG, INFO, WARNING, ERROR）
# LOG_LEVEL=INFO

# 跳过数据库结构检查（可选，设为 true 跳过启动时的数据库检查）
# DB_SKIP_CHECK=true

# 管理员账号（可选，首次启动时创建，默认 admin / admin123）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
