# PostgreSQL 连接地址（必填），包含账号、密码、主机、端口和数据库名
PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/imgtag

# 存储凭据加密密钥（可选）；修改后重启，自动重新加密已有凭据
# 不配置时沿用数据库密钥，新库会自动生成；旧库首次接入时保留原自定义密钥
# IMGTAG_SECRET_KEY=your-secret-key

# 数据库连接池（每个应用进程独立，上限为 DB_POOL_SIZE + DB_MAX_OVERFLOW）
# 常驻连接池容量
DB_POOL_SIZE=5
# 连接池满时允许额外创建的连接数；0 表示不扩容
DB_MAX_OVERFLOW=0
# 等待空闲数据库连接的最长时间（秒）
DB_POOL_TIMEOUT=30
# 连接创建超过此时长后，在下次借出时重建（秒）
DB_POOL_RECYCLE=600
# 借出连接前检查其是否可用，减少失效连接引发的请求错误
DB_POOL_PRE_PING=true

# 存储同步与请求
# 每个进程并行同步批次数及 S3 请求线程数上限；同一端点的任务仍串行执行
STORAGE_SYNC_CONCURRENCY=2
# 同步操作遇到临时数据库异常时的最多尝试次数（包含首次执行）
STORAGE_SYNC_DB_MAX_ATTEMPTS=5
# 数据库重试的初始等待时间（秒），后续逐次翻倍（基础等待最多 30 秒）并加入少量随机延迟
STORAGE_SYNC_DB_RETRY_DELAY=2
# 建立 S3 连接的超时时间（秒）
STORAGE_CONNECT_TIMEOUT=5
# 等待 S3 响应数据的读取超时时间（秒），并非整个文件的传输时限
STORAGE_READ_TIMEOUT=30
# 单次 S3 API 请求的最多尝试次数（包含首次请求）
STORAGE_REQUEST_ATTEMPTS=2
# 单张同步、单项清理或单次存储操作的处理时限（秒）；在途删除另行收尾
STORAGE_ITEM_TIMEOUT=60
# 连续失败达到此次数后停止当前任务，保留已完成结果
STORAGE_MAX_CONSECUTIVE_FAILURES=3
# 存储任务心跳超过此时长未更新后，允许恢复服务接管（秒）
# 保存任务进度时同时刷新心跳；没有近期进度时才补写，检查间隔为 15 秒与本值三分之一中的较小值
# 空闲时不写心跳；调度由进程内事件唤醒，启动及每 5 分钟执行兜底检查
# 异常退出留下的删除收尾标记，通过“解除关联”的本地清理手动释放
STORAGE_TASK_LEASE_SECONDS=60

# 默认上传目录（可选）：相对路径位于数据目录下，默认是项目 data/uploads；也可指定绝对路径
# UPLOAD_DIR=/path/to/uploads

# 日志级别：DEBUG、INFO、WARNING、ERROR，默认 INFO
# 写入控制台和 logs/api.log；DEBUG 包含搜索耗时、存储任务心跳及恢复检查日志
# LOG_LEVEL=INFO

# 以下管理员选项通过进程环境变量设置，不写入 .env；不会修改同名已有账号
# 初始化管理员的用户名，默认 admin
# ADMIN_USERNAME=admin
# 初始化管理员的密码，默认 admin123
# ADMIN_PASSWORD=admin123
